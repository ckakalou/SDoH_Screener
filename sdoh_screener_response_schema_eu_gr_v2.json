{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healie.ai/schemas/sdoh_screener_response_schema_eu_gr_v3.json",
  "title": "SD-DOH Assessment Response Schema – EU/GR v3",
  "description": "Validates responses for the HEALIE Social and Digital Determinants of Health assessment.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dem_age_group": {
      "type": "string",
      "enum": [
        "16_17",
        "18_21",
        "22_30",
        "31_40",
        "41_50",
        "51_60",
        "61_70",
        "71_80",
        "81_plus",
        "prefer_not_answer"
      ]
    },
    "dem_gender": {
      "type": "string",
      "enum": [
        "woman",
        "man",
        "non_binary",
        "another_gender",
        "prefer_not_answer"
      ]
    },
    "dem_gender_other_text": {
      "type": "string"
    },
    "q1_ethnic_group": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "white",
          "black_or_african",
          "asian",
          "hispanic_latino",
          "arab",
          "other"
        ]
      },
      "uniqueItems": true
    },
    "q1_ethnic_group_other_text": {
      "type": "string"
    },
    "q2_europe_region": {
      "type": "string",
      "enum": [
        "northern_europe",
        "western_europe",
        "southern_europe",
        "eastern_europe",
        "central_europe",
        "not_in_europe",
        "prefer_not_to_say"
      ]
    },
    "q2_ancestry": {
      "type": "string"
    },
    "q3_household_income": {
      "type": "string",
      "enum": [
        "lt_10000",
        "10000_19999",
        "20000_29999",
        "30000_39999",
        "40000_59999",
        "60000_79999",
        "80000_99999",
        "ge_100000",
        "prefer_not_to_say"
      ]
    },
    "q4_education": {
      "type": "string",
      "enum": [
        "no_formal",
        "primary",
        "lower_secondary",
        "upper_secondary",
        "vocational",
        "undergraduate",
        "masters",
        "doctorate",
        "prefer_not_to_say"
      ]
    },
    "q5_work_status": {
      "type": "string",
      "enum": [
        "full_time",
        "part_time",
        "self_employed",
        "unemployed",
        "homemaker",
        "student",
        "retired",
        "unable_disability",
        "other",
        "prefer_not_to_say"
      ]
    },
    "q5b_last_worked": {
      "type": "string",
      "enum": [
        "past_12_months",
        "one_to_five_years",
        "over_five_or_never"
      ]
    },
    "q6a_housing_situation": {
      "type": "string",
      "enum": [
        "have_housing",
        "worried_losing",
        "no_housing",
        "prefer_not_answer"
      ]
    },
    "q6b_tenure": {
      "type": "string",
      "enum": [
        "owned_with_mortgage",
        "owned_free_clear",
        "rented",
        "no_rent"
      ]
    },
    "q6c_monthly_housing_cost": {
      "type": "number",
      "minimum": 0
    },
    "q6d_difficult_to_pay_housing": {
      "type": "boolean"
    },
    "q6e_worry_housing_costs": {
      "type": "string",
      "enum": [
        "very_worried",
        "moderately_worried",
        "not_too_worried",
        "not_worried"
      ]
    },
    "q7_building_type": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "multi_unit",
          "detached_house",
          "attached_house",
          "mobile_home"
        ]
      },
      "uniqueItems": true
    },
    "q8a_household_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "q8b_bedrooms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "q9a_residence_length": {
      "type": "string",
      "enum": [
        "lt6mo",
        "6to12mo",
        "1to3y",
        "gt3y"
      ]
    },
    "q9b_longest_zip": {
      "type": "string",
      "pattern": "^[A-Za-z0-9 \\-]{3,10}$"
    },
    "q10_health_coverage": {
      "type": "string",
      "enum": [
        "public_only",
        "private_only",
        "both_public_private",
        "no_coverage",
        "other",
        "not_sure",
        "prefer_not_to_say"
      ]
    },
    "q10_health_coverage_other_text": {
      "type": "string"
    },
    "q11_internet": {
      "type": "boolean"
    },
    "q12_disability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "q12a_hearing": {
          "type": "boolean"
        },
        "q12b_vision": {
          "type": "boolean"
        },
        "q12c_cognitive": {
          "type": "boolean"
        },
        "q12d_mobility": {
          "type": "boolean"
        },
        "q12e_adl": {
          "type": "boolean"
        },
        "q12f_iadl": {
          "type": "boolean"
        }
      },
      "required": [
        "q12a_hearing",
        "q12b_vision",
        "q12c_cognitive",
        "q12d_mobility",
        "q12e_adl",
        "q12f_iadl"
      ]
    },
    "q13_local_language_proficiency": {
      "type": "string",
      "enum": [
        "very_well",
        "well",
        "not_well",
        "not_at_all"
      ]
    },
    "q14a_marital_status": {
      "type": "string",
      "enum": [
        "now_married",
        "widowed",
        "divorced",
        "separated",
        "never_married",
        "living_with_partner",
        "prefer_not_to_say"
      ]
    },
    "q14b_single_parent": {
      "type": "boolean"
    },
    "q15a_commute_mode": {
      "type": "string",
      "enum": [
        "car_motorcycle_scooter",
        "bus_coach_minibus",
        "metro_tram_light_rail",
        "train",
        "taxi_ride_hailing",
        "ferry_boat",
        "bicycle",
        "walked",
        "worked_from_home",
        "did_not_travel",
        "other"
      ]
    },
    "q15a_commute_mode_other_text": {
      "type": "string"
    },
    "q15b_transport_barrier": {
      "type": "boolean"
    },
    "q16_unmet_needs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "q16_food": {
          "type": "boolean"
        },
        "q16_healthy_food": {
          "type": "boolean"
        },
        "q16_healthcare": {
          "type": "boolean"
        },
        "q16_phone": {
          "type": "boolean"
        },
        "q16_decline": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "q16_decline": {
                "const": true
              }
            },
            "required": [
              "q16_decline"
            ]
          },
          "then": {
            "required": [
              "q16_decline"
            ]
          },
          "else": {
            "required": [
              "q16_food",
              "q16_healthy_food",
              "q16_healthcare",
              "q16_phone",
              "q16_decline"
            ]
          }
        }
      ]
    },
    "q16a_medical_bills": {
      "type": "boolean"
    },
    "q16b_delayed_care_cost": {
      "type": "boolean"
    },
    "q16c_worry_housing_repeat": {
      "type": "string",
      "enum": [
        "very_worried",
        "moderately_worried",
        "not_too_worried",
        "not_worried"
      ]
    },
    "q16d_worry_bills": {
      "type": "string",
      "enum": [
        "very_worried",
        "moderately_worried",
        "not_too_worried",
        "not_worried"
      ]
    },
    "q17_social_connections": {
      "type": "string",
      "enum": [
        "lt_once_week",
        "1_2_week",
        "3_5_week",
        "6plus_week",
        "decline"
      ]
    },
    "q18_neighborhood_support": {
      "type": "string",
      "enum": [
        "definitely_agree",
        "somewhat_agree",
        "somewhat_disagree",
        "definitely_disagree"
      ]
    },
    "q19a_phq2_participation": {
      "type": "string",
      "enum": [
        "answer",
        "decline"
      ]
    },
    "q19a_phq2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phq2_item1": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "phq2_item2": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "phq2_item1",
        "phq2_item2"
      ]
    },
    "q19b_partner_status": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "prefer_not_answer"
      ]
    },
    "q19b_ipv_hits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hits_hurt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "hits_insult": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "hits_threaten": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "hits_scream": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "hits_hurt",
        "hits_insult",
        "hits_threaten",
        "hits_scream"
      ]
    },
    "q19c_gad2_participation": {
      "type": "string",
      "enum": [
        "answer",
        "decline"
      ]
    },
    "q19c_gad2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gad2_item1": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "gad2_item2": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "gad2_item1",
        "gad2_item2"
      ]
    },
    "q19d_cognition_selfreport": {
      "type": "string",
      "enum": [
        "no",
        "yes_some",
        "yes_often",
        "prefer_not_to_say"
      ]
    },
    "q19e_mmse_total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    },
    "q20a_pa_days": {
      "type": "string",
      "enum": [
        "0",
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7"
      ]
    },
    "q20b_pa_minutes": {
      "type": "number",
      "enum": [
        0,
        10,
        20,
        30,
        40,
        50,
        60,
        90,
        120,
        150
      ]
    },
    "legal_need": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "not_sure",
        "prefer_not_answer"
      ]
    },
    "legal_need_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "income_benefits_insurance",
          "housing_utilities",
          "education",
          "employment",
          "healthcare_coverage_access",
          "residence_immigration_documentation",
          "family_care_custody",
          "safety_violence_discrimination",
          "debt_consumer",
          "other",
          "prefer_not_answer"
        ]
      },
      "uniqueItems": true
    },
    "legal_need_other_text": {
      "type": "string"
    },
    "legal_support_access": {
      "type": "string",
      "enum": [
        "all_support",
        "some_not_enough",
        "tried_none",
        "did_not_know_where",
        "cost_or_access_barrier",
        "chose_not_to_seek",
        "prefer_not_answer"
      ]
    },
    "ddoh_device_access": {
      "type": "string",
      "enum": [
        "always",
        "often",
        "sometimes",
        "never",
        "prefer_not_answer"
      ]
    },
    "ddoh_connectivity": {
      "type": "string",
      "enum": [
        "always",
        "often",
        "sometimes",
        "never",
        "prefer_not_answer"
      ]
    },
    "ddoh_affordability": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "not_sure",
        "prefer_not_answer"
      ]
    },
    "ddoh_accessibility": {
      "type": "string",
      "enum": [
        "always",
        "often",
        "sometimes",
        "never",
        "not_used",
        "prefer_not_answer"
      ]
    },
    "ddoh_support": {
      "type": "string",
      "enum": [
        "always",
        "often",
        "sometimes",
        "never",
        "no_assistance_needed",
        "not_used",
        "prefer_not_answer"
      ]
    },
    "ddoh_privacy_trust": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "not_sure",
        "not_used",
        "prefer_not_answer"
      ]
    }
  },
  "required": [],
  "examples": []
}
